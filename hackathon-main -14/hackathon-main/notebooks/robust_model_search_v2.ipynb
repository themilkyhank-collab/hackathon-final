{"cells":[{"cell_type":"markdown","metadata":{},"source":["# Robust semi-supervised model search v2\n","\n","**Cel:** wycisnąć więcej z `val.csv` bez używania `test.csv` do strojenia.\n","\n","Kluczowa zmiana: nie używamy odległości do medianowych prototypów jako głównego pseudo-labelera. Uczymy klasyfikator bezpośrednio na oznaczonym `val` reference i dopiero jego wysokopewne predykcje na `train.csv` stają się pseudo-labelami.\n","\n","Score: `0.75 * Macro-F1(label) + 0.25 * Accuracy(severity dla prawdziwie uszkodzonych)`. `test.csv` jest ładowany dopiero w ostatniej komórce i służy wyłącznie do finalnej predykcji."]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["from pathlib import Path\n","import warnings, time, json\n","warnings.filterwarnings('ignore')\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","from sklearn.impute import SimpleImputer\n","from sklearn.preprocessing import StandardScaler, LabelEncoder\n","from sklearn.pipeline import Pipeline\n","from sklearn.model_selection import GroupKFold, ParameterSampler\n","from sklearn.metrics import accuracy_score, f1_score, classification_report\n","from sklearn.ensemble import ExtraTreesClassifier, RandomForestClassifier, HistGradientBoostingClassifier, IsolationForest\n","from sklearn.svm import SVC\n","from sklearn.neural_network import MLPClassifier\n","from sklearn.linear_model import LogisticRegression\n","from src.common import FREQ_COLS, LABELS, FAULT_LABELS\n","from src.features import FeatureExtractor\n","SEED=42\n","DATA_DIR=Path('data')\n","FAULTS=['zakoksowany','lejacy','pompa','iglica']\n","SEVERITIES=['male','srednie','duze']\n","print('READY')"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# Load train/val only. test is intentionally not loaded here.\n","train_raw=pd.read_csv(DATA_DIR/'train.csv')\n","val_raw=pd.read_csv(DATA_DIR/'val.csv')\n","assert 'label' not in train_raw.columns\n","assert {'label','severity'}.issubset(val_raw.columns)\n","assert set(train_raw.engine_id).isdisjoint(set(val_raw.engine_id))\n","print(f'train: {len(train_raw):,} rows / {train_raw.engine_id.nunique()} engines')\n","print(f'val: {len(val_raw):,} rows / {val_raw.engine_id.nunique()} engines')\n","print('\\nVAL label distribution:')\n","print(val_raw.label.value_counts())\n","print('\\nVAL severity distribution:')\n","print(val_raw.severity.value_counts())"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# Robust spectral cleaning + feature extraction.\n","def clean_spectrum(df):\n","    out=df.copy()\n","    out[FREQ_COLS]=out[FREQ_COLS].interpolate(axis=1,limit_direction='both')\n","    out[FREQ_COLS]=out[FREQ_COLS].fillna(out[FREQ_COLS].median())\n","    return out\n","train=clean_spectrum(train_raw)\n","val=clean_spectrum(val_raw)\n","extractor=FeatureExtractor()\n","train_f=extractor.fit_transform(train)\n","val_f=extractor.transform(val)\n","features=extractor.get_feature_names()\n","X_train_full=np.nan_to_num(train_f[features].to_numpy(np.float32),nan=0,posinf=0,neginf=0)\n","X_val_full=np.nan_to_num(val_f[features].to_numpy(np.float32),nan=0,posinf=0,neginf=0)\n","print('Full features:',len(features))"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# Feature ranking using labeled VAL only; diagnostic plot.\n","def rank_features(X,y,names,top_n=32):\n","    le=LabelEncoder().fit(y)\n","    m=ExtraTreesClassifier(n_estimators=800,max_features=1.0,max_depth=15,min_samples_leaf=2,class_weight='balanced',n_jobs=-1,random_state=SEED)\n","    m.fit(X,le.transform(y))\n","    imp=pd.DataFrame({'feature':names,'importance':m.feature_importances_}).sort_values('importance',ascending=False).reset_index(drop=True)\n","    return imp.head(top_n),imp\n","top_imp,all_imp=rank_features(X_val_full,val.label.astype(str).to_numpy(),features,32)\n","plot_df=top_imp.sort_values('importance')\n","plt.figure(figsize=(10,8)); plt.barh(plot_df.feature,plot_df.importance); plt.xlabel('Importance'); plt.ylabel('Feature'); plt.title('Top feature importance — labeled VAL'); plt.tight_layout(); plt.show()\n","SELECTED=top_imp.feature.tolist()\n","IDX=[features.index(f) for f in SELECTED]\n","print('Selected:',SELECTED)"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# Stronger pseudo-labeler: supervised classifier trained on labeled reference.\n","def make_label_model(name,params):\n","    if name=='extra_trees': return ExtraTreesClassifier(random_state=SEED,n_jobs=-1,class_weight='balanced',**params)\n","    if name=='random_forest': return RandomForestClassifier(random_state=SEED,n_jobs=-1,class_weight='balanced',**params)\n","    if name=='svc': return Pipeline([('scale',StandardScaler()),('clf',SVC(probability=True,class_weight='balanced',random_state=SEED,**params))])\n","    if name=='mlp': return Pipeline([('scale',StandardScaler()),('clf',MLPClassifier(random_state=SEED,early_stopping=True,validation_fraction=.2,n_iter_no_change=30,max_iter=800,**params))])\n","    if name=='hist_gb': return HistGradientBoostingClassifier(random_state=SEED,**params)\n","    raise ValueError(name)\n","SPACES={\n"," 'extra_trees':{'n_estimators':[150,300,600],'max_features':[.5,.8,1.0],'max_depth':[8,12,15,20,None],'min_samples_leaf':[1,2,3,5]},\n"," 'random_forest':{'n_estimators':[300,600],'max_features':['sqrt',.6,1.0],'max_depth':[8,12,18,None],'min_samples_leaf':[1,2,4]},\n"," 'svc':{'C':[.3,1,3,10,30],'gamma':['scale',.01,.03,.1],'kernel':['rbf']},\n"," 'mlp':{'hidden_layer_sizes':[(32,),(64,),(64,32),(128,64)],'alpha':[1e-4,1e-3,1e-2,.05],'learning_rate_init':[1e-3,3e-4]},\n"," 'hist_gb':{'max_iter':[150,250,400],'learning_rate':[.03,.05,.08],'max_leaf_nodes':[15,31,63],'min_samples_leaf':[10,20,30],'l2_regularization':[.5,1,3]}\n","}\n","TRIALS_PER_MODEL=8\n","THRESHOLDS=[.50,.60,.70,.80,.90]\n","print('Models:',list(SPACES))"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["def score_predictions(y_true_label,y_pred_label,y_true_sev,y_pred_sev):\n","    macro=f1_score(y_true_label,y_pred_label,average='macro',zero_division=0)\n","    fault=np.isin(y_true_label,FAULTS)\n","    sev_acc=accuracy_score(y_true_sev[fault],y_pred_sev[fault]) if fault.any() else 0.0\n","    return .75*macro+.25*sev_acc,macro,sev_acc\n","def fit_severity_model(X,y):\n","    return ExtraTreesClassifier(n_estimators=300,max_features=.8,max_depth=8,min_samples_leaf=3,class_weight='balanced',n_jobs=-1,random_state=SEED).fit(X,y)\n","def pseudo_from_reference(ref_X,ref_y,train_X,model_name,params):\n","    le=LabelEncoder().fit(ref_y)\n","    model=make_label_model(model_name,params)\n","    model.fit(ref_X,le.transform(ref_y))\n","    proba=model.predict_proba(train_X)\n","    conf=proba.max(axis=1)\n","    pred=le.inverse_transform(proba.argmax(axis=1))\n","    return model,le,pred,conf"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# Grouped CV on labeled VAL. Each holdout engine is unseen by the reference model.\n","gkf=GroupKFold(n_splits=4)\n","results=[]\n","for model_name,space in SPACES.items():\n","    sampler=list(ParameterSampler(space,n_iter=TRIALS_PER_MODEL,random_state=SEED))\n","    print(f'\\nMODEL: {model_name} | {len(sampler)} configs')\n","    for trial,params in enumerate(sampler,1):\n","        fold_rows=[]\n","        for fold,(ref_idx,hold_idx) in enumerate(gkf.split(val,groups=val.engine_id),1):\n","            ref_X=X_val_full[ref_idx][:,IDX]; hold_X=X_val_full[hold_idx][:,IDX]\n","            ref_y=val.label.iloc[ref_idx].astype(str).to_numpy(); hold_y=val.label.iloc[hold_idx].astype(str).to_numpy()\n","            ref_s=val.severity.iloc[ref_idx].astype(str).to_numpy(); hold_s=val.severity.iloc[hold_idx].astype(str).to_numpy()\n","            _,le,pseudo,conf=pseudo_from_reference(ref_X,ref_y,X_train_full[:,IDX],model_name,params)\n","            for threshold in THRESHOLDS:\n","                keep=conf>=threshold\n","                X_aug=np.vstack([ref_X,X_train_full[keep][:,IDX]])\n","                y_aug=np.concatenate([ref_y,pseudo[keep]])\n","                aug_le=LabelEncoder().fit(LABELS)\n","                final_model=make_label_model(model_name,params).fit(X_aug,aug_le.transform(y_aug))\n","                pred_label=aug_le.inverse_transform(final_model.predict(hold_X))\n","                # Severity pseudo-labels from labeled reference severity prototypes.\n","                sx=[]; sy=[]\n","                for fault in FAULTS:\n","                    tm=(pseudo==fault)&keep\n","                    if not tm.any(): continue\n","                    prot=[]; names=[]\n","                    for sev in SEVERITIES:\n","                        rm=(ref_y==fault)&(ref_s==sev)\n","                        if rm.any(): prot.append(np.median(ref_X[rm],axis=0)); names.append(sev)\n","                    if len(prot)<2: continue\n","                    d=np.stack([np.linalg.norm(X_train_full[tm][:,IDX]-p,axis=1) for p in prot],axis=1)\n","                    sx.append(X_train_full[tm][:,IDX]); sy.extend(np.asarray(names,dtype=object)[d.argmin(1)])\n","                if sx:\n","                    sx=np.vstack(sx); sy=np.asarray(sy,dtype=object)\n","                    sx=np.vstack([sx,ref_X[np.isin(ref_y,FAULTS)]]); sy=np.concatenate([sy,ref_s[np.isin(ref_y,FAULTS)]])\n","                    sev_model=fit_severity_model(sx,sy)\n","                    pred_sev=np.full(len(hold_X),'nie_dotyczy',dtype=object)\n","                    fp=np.isin(pred_label,FAULTS)\n","                    if fp.any(): pred_sev[fp]=sev_model.predict(hold_X[fp])\n","                else: pred_sev=np.full(len(hold_X),'nie_dotyczy',dtype=object)\n","                raw,macro,sev_acc=score_predictions(hold_y,pred_label,hold_s,pred_sev)\n","                fold_rows.append({'model':model_name,'trial':trial,'fold':fold,'threshold':threshold,'raw_score':raw,'macro_f1':macro,'severity_accuracy':sev_acc,'pseudo_keep':float(keep.mean()),'params':json.dumps(params,default=str)})\n","        results.extend(fold_rows)\n","        agg=pd.DataFrame(fold_rows).groupby('threshold').agg(raw_score=('raw_score','mean'),macro_f1=('macro_f1','mean'),severity_accuracy=('severity_accuracy','mean'),pseudo_keep=('pseudo_keep','mean'))\n","        bt=agg.raw_score.idxmax(); print(f'trial={trial:02d} raw={agg.loc[bt,"raw_score"]:.4f} macro={agg.loc[bt,"macro_f1"]:.4f} sev={agg.loc[bt,"severity_accuracy"]:.4f} thr={bt} keep={agg.loc[bt,"pseudo_keep"]:.1%} params={params}')\n","results_df=pd.DataFrame(results)\n","summary=(results_df.groupby(['model','trial','threshold'],as_index=False).agg(raw_score=('raw_score','mean'),macro_f1=('macro_f1','mean'),severity_accuracy=('severity_accuracy','mean'),pseudo_keep=('pseudo_keep','mean')).sort_values('raw_score',ascending=False))\n","display(summary.head(30))"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["best=summary.iloc[0]\n","print('BEST CV CONFIGURATION')\n","print(best.to_string())\n","display(summary.groupby('model',as_index=False).agg(best_raw=('raw_score','max'),best_macro=('macro_f1','max')).sort_values('best_raw',ascending=False))"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# Final fit on ALL labeled VAL + selected high-confidence pseudo-labeled TRAIN.\n","# TEST is intentionally loaded only after model selection.\n","best_model_name=str(best.model); best_trial=int(best.trial); best_threshold=float(best.threshold)\n","row=results_df[(results_df.model==best_model_name)&(results_df.trial==best_trial)&(results_df.threshold==best_threshold)].iloc[0]\n","best_params=json.loads(row.params)\n","ref_X=X_val_full[:,IDX]; ref_y=val.label.astype(str).to_numpy()\n","_,le,pseudo,conf=pseudo_from_reference(ref_X,ref_y,X_train_full[:,IDX],best_model_name,best_params)\n","keep=conf>=best_threshold\n","X_aug=np.vstack([ref_X,X_train_full[keep][:,IDX]]); y_aug=np.concatenate([ref_y,pseudo[keep]])\n","final_le=LabelEncoder().fit(LABELS)\n","final_model=make_label_model(best_model_name,best_params).fit(X_aug,final_le.transform(y_aug))\n","print('Final model:',best_model_name)\n","print('Pseudo-label keep:',f'{keep.mean():.1%}')\n","print('Training rows:',len(y_aug))"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# FINAL TEST INFERENCE — test is read only here.\n","test_raw=pd.read_csv(DATA_DIR/'test.csv')\n","test=clean_spectrum(test_raw)\n","test_f=extractor.transform(test)\n","X_test_full=np.nan_to_num(test_f[features].to_numpy(np.float32),nan=0,posinf=0,neginf=0)\n","X_test=X_test_full[:,IDX]\n","pred_label=final_le.inverse_transform(final_model.predict(X_test))\n","# Severity model: reference VAL labels + high-confidence pseudo TRAIN.\n","sx=[]; sy=[]\n","for fault in FAULTS:\n","    tm=(pseudo==fault)&keep\n","    if not tm.any(): continue\n","    prot=[]; names=[]\n","    for sev in SEVERITIES:\n","        rm=(ref_y==fault)&(val.severity.astype(str).to_numpy()==sev)\n","        if rm.any(): prot.append(np.median(ref_X[rm],axis=0)); names.append(sev)\n","    if len(prot)>=2:\n","        d=np.stack([np.linalg.norm(X_train_full[tm][:,IDX]-p,axis=1) for p in prot],axis=1)\n","        sx.append(X_train_full[tm][:,IDX]); sy.extend(np.asarray(names,dtype=object)[d.argmin(1)])\n","val_fault=np.isin(ref_y,FAULTS)\n","sx.append(ref_X[val_fault]); sy.extend(val.severity.astype(str).to_numpy()[val_fault])\n","sev_model=fit_severity_model(np.vstack(sx),np.asarray(sy,dtype=object))\n","pred_sev=np.full(len(test),'nie_dotyczy',dtype=object)\n","fp=np.isin(pred_label,FAULTS)\n","pred_sev[fp]=sev_model.predict(X_test[fp])\n","submission=test_raw[['engine_id','cylinder']].copy(); submission['label']=pred_label; submission['severity']=pred_sev\n","submission.to_csv('predictions.csv',index=False)\n","print('FINAL TEST PREDICTIONS'); print(submission.head(20).to_string(index=False))\n","print('\\nLabel distribution:'); print(submission.label.value_counts())\n","print('\\nSeverity distribution:'); print(submission.severity.value_counts())\n","print('\\nSaved predictions.csv:',len(submission),'rows')"]}],"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.x"}},"nbformat":4,"nbformat_minor":5}