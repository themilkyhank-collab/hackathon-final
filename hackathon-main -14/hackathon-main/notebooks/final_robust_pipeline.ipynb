{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Final Robust Pipeline — Label + Severity\n",
        "\n",
        "**No hyperparameter search.** This is the production-style pipeline after model selection.\n",
        "\n",
        "Label model: first-difference spectrum + RBF SVC (`C=1.0`, `gamma=0.0175`).\n",
        "Severity model: separate ExtraTrees classifier trained only on labeled fault samples.\n",
        "Isolation Forest is fitted only on the unlabeled training set and used as an anomaly feature/explanation.\n",
        "\n",
        "`test.csv` is never used until the explicit final-inference cell at the bottom."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "!pip -q install scikit-learn pandas numpy matplotlib\n",
        "from pathlib import Path\n",
        "import json, warnings, time\n",
        "warnings.filterwarnings('ignore')\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.svm import SVC\n",
        "from sklearn.ensemble import ExtraTreesClassifier, IsolationForest\n",
        "from sklearn.model_selection import GroupKFold\n",
        "from sklearn.metrics import f1_score, accuracy_score, classification_report, confusion_matrix\n",
        "SEED = 42\n",
        "FAULTS = {'zakoksowany','lejacy','pompa','iglica'}\n",
        "SEVERITY_ORDER = ['male','srednie','duze']\n",
        "NON_FAULT_SEVERITY = 'nie_dotyczy'\n",
        "LABEL_C = 1.0\n",
        "LABEL_GAMMA = 0.0175\n",
        "print('Final robust pipeline ready')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "try:\n",
        "    from google.colab import drive\n",
        "    drive.mount('/content/drive', force_remount=False)\n",
        "except Exception as e:\n",
        "    print('Drive mount unavailable:', e)\n",
        "candidates = [Path('/content/data'), Path('/content/drive/MyDrive/hackathon/data'), Path('/content/drive/MyDrive/data')]\n",
        "DATA_DIR = next((p for p in candidates if (p/'train.csv').exists() and (p/'val.csv').exists()), None)\n",
        "if DATA_DIR is None:\n",
        "    raise FileNotFoundError('Put train.csv and val.csv in MyDrive/hackathon/data/ or /content/data/')\n",
        "train = pd.read_csv(DATA_DIR/'train.csv')\n",
        "val = pd.read_csv(DATA_DIR/'val.csv')\n",
        "assert 'label' not in train.columns, 'train.csv must remain unlabeled'\n",
        "assert {'label','engine_id'}.issubset(val.columns), 'val.csv needs label and engine_id'\n",
        "assert set(train.engine_id).isdisjoint(set(val.engine_id)), 'train/val engine leakage detected'\n",
        "severity_candidates = ['severity','Severity','severity_label','severity_class']\n",
        "SEVERITY_COL = next((c for c in severity_candidates if c in val.columns), None)\n",
        "if SEVERITY_COL is None:\n",
        "    raise ValueError('No severity column found in val.csv. Expected one of: ' + ', '.join(severity_candidates))\n",
        "freq = sorted([c for c in train.columns if c.startswith('mV_')], key=lambda x: int(x.split('_')[1]))\n",
        "if len(freq) < 3: raise ValueError('Expected at least 3 mV_* columns')\n",
        "print('DATA_DIR:', DATA_DIR)\n",
        "print('train:', train.shape, 'val:', val.shape)\n",
        "print('severity column:', SEVERITY_COL)\n",
        "print('label distribution:\n', val.label.value_counts(dropna=False))\n",
        "print('severity distribution:\n', val[SEVERITY_COL].value_counts(dropna=False))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def get_spectrum(df):\n",
        "    x = df[freq].copy().interpolate(axis=1, limit_direction='both').fillna(0.0)\n",
        "    return x.to_numpy(dtype=float)\n",
        "\n",
        "def d1_features(df):\n",
        "    a = get_spectrum(df)\n",
        "    d = np.diff(a, axis=1)\n",
        "    return d\n",
        "\n",
        "def severity_features(df, anomaly_score=None):\n",
        "    a = get_spectrum(df)\n",
        "    d = np.diff(a, axis=1)\n",
        "    d2 = np.diff(a, n=2, axis=1)\n",
        "    feats = np.column_stack([\n",
        "        d,\n",
        "        a.mean(axis=1), a.std(axis=1), a.min(axis=1), a.max(axis=1), np.ptp(a,axis=1),\n",
        "        np.mean(np.abs(a),axis=1), np.mean(a*a,axis=1),\n",
        "        d.mean(axis=1), d.std(axis=1), d.min(axis=1), d.max(axis=1),\n",
        "        np.mean(np.abs(d),axis=1), np.mean(d*d,axis=1),\n",
        "        d2.mean(axis=1), d2.std(axis=1), d2.min(axis=1), d2.max(axis=1),\n",
        "        np.argmax(a,axis=1), np.argmin(a,axis=1)\n",
        "    ])\n",
        "    if anomaly_score is not None:\n",
        "        feats = np.column_stack([feats, np.asarray(anomaly_score).reshape(-1)])\n",
        "    return np.nan_to_num(feats, nan=0.0, posinf=0.0, neginf=0.0)\n",
        "\n",
        "X_label = d1_features(val)\n",
        "X_train_label = d1_features(train)\n",
        "print('label features:', X_label.shape)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Isolation Forest: unsupervised anomaly signal learned ONLY from unlabeled train.csv.\n",
        "# It is deliberately not used as a target or as a source of labels.\n",
        "iso = Pipeline([\n",
        "    ('scale', StandardScaler()),\n",
        "    ('iforest', IsolationForest(n_estimators=400, max_samples='auto', contamination='auto', random_state=SEED, n_jobs=-1))\n",
        "])\n",
        "iso.fit(X_train_label)\n",
        "train_anom = -iso.decision_function(X_train_label)\n",
        "val_anom = -iso.decision_function(X_label)\n",
        "print('anomaly score train mean/std:', float(train_anom.mean()), float(train_anom.std()))\n",
        "print('anomaly score val mean/std:', float(val_anom.mean()), float(val_anom.std()))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Final fixed label model. No search.\n",
        "label_model = Pipeline([\n",
        "    ('scale', StandardScaler()),\n",
        "    ('svc', SVC(C=LABEL_C, gamma=LABEL_GAMMA, kernel='rbf', class_weight='balanced', probability=True, random_state=SEED))\n",
        "])\n",
        "\n",
        "# Severity model: only fault rows and only labeled validation data are used.\n",
        "y_label = val.label.astype(str).str.strip()\n",
        "y_sev_raw = val[SEVERITY_COL].astype(str).str.strip().str.lower()\n",
        "fault_mask = y_label.isin(FAULTS)\n",
        "severity_valid = y_sev_raw.isin(SEVERITY_ORDER)\n",
        "severity_train_mask = fault_mask & severity_valid\n",
        "if severity_train_mask.sum() < 10: raise ValueError('Too few labeled fault+severity samples to train severity model')\n",
        "X_sev = severity_features(val, val_anom)\n",
        "severity_model = ExtraTreesClassifier(\n",
        "    n_estimators=500, max_features='sqrt', max_depth=12, min_samples_leaf=2,\n",
        "    class_weight='balanced', random_state=SEED, n_jobs=-1\n",
        ")\n",
        "print('severity training rows:', int(severity_train_mask.sum()))\n",
        "print('severity classes:', sorted(y_sev_raw[severity_train_mask].unique()))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Leakage-safe grouped CV for BOTH models. This is evaluation only.\n",
        "gkf = GroupKFold(n_splits=min(5, val.engine_id.nunique()))\n",
        "oof_label = np.empty(len(val), dtype=object)\n",
        "oof_sev = np.full(len(val), NON_FAULT_SEVERITY, dtype=object)\n",
        "\n",
        "for fold, (tr, ho) in enumerate(gkf.split(X_label, groups=val.engine_id), 1):\n",
        "    lm = Pipeline([('scale', StandardScaler()), ('svc', SVC(C=LABEL_C, gamma=LABEL_GAMMA, kernel='rbf', class_weight='balanced', random_state=SEED))])\n",
        "    lm.fit(X_label[tr], y_label.iloc[tr])\n",
        "    oof_label[ho] = lm.predict(X_label[ho])\n",
        "    sev_train = np.array([i for i in tr if y_label.iloc[i] in FAULTS and y_sev_raw.iloc[i] in SEVERITY_ORDER])\n",
        "    if len(sev_train) >= 6 and len(np.unique(y_sev_raw.iloc[sev_train])) >= 2:\n",
        "        sm = ExtraTreesClassifier(n_estimators=500, max_features='sqrt', max_depth=12, min_samples_leaf=2, class_weight='balanced', random_state=SEED, n_jobs=-1)\n",
        "        sm.fit(X_sev[sev_train], y_sev_raw.iloc[sev_train])\n",
        "        fault_pred = oof_label[ho]\n",
        "        target_positions = np.array([j for j,i in enumerate(ho) if fault_pred[j] in FAULTS])\n",
        "        if len(target_positions):\n",
        "            oof_sev[ho[target_positions]] = sm.predict(X_sev[ho[target_positions]])\n",
        "    print(f'fold {fold}: label macro-F1={f1_score(y_label.iloc[ho], oof_label[ho], average="macro", zero_division=0):.4f}')\n",
        "\n",
        "label_macro = f1_score(y_label, oof_label, average='macro', zero_division=0)\n",
        "fault_eval = y_label.isin(FAULTS)\n",
        "sev_eval = fault_eval & y_sev_raw.isin(SEVERITY_ORDER)\n",
        "sev_acc = accuracy_score(y_sev_raw[sev_eval], oof_sev[sev_eval]) if sev_eval.any() else float('nan')\n",
        "raw_score = 0.75 * label_macro + 0.25 * sev_acc if np.isfinite(sev_acc) else float('nan')\n",
        "print('\\n=== OFFICIAL-STYLE OOF SUMMARY ===')\n",
        "print(f'label Macro-F1:       {label_macro:.6f}')\n",
        "print(f'severity accuracy:     {sev_acc:.6f}')\n",
        "print(f'raw score:             {raw_score:.6f}')\n",
        "print('\\nLabel classification report:')\n",
        "print(classification_report(y_label, oof_label, zero_division=0))\n",
        "print('\\nSeverity classification report (labeled faults only):')\n",
        "print(classification_report(y_sev_raw[sev_eval], oof_sev[sev_eval], labels=SEVERITY_ORDER, zero_division=0))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Fit the final production models on ALL labeled val data.\n",
        "# train.csv has no labels, so it is used for the unsupervised anomaly model only.\n",
        "label_model.fit(X_label, y_label)\n",
        "severity_model.fit(X_sev[severity_train_mask], y_sev_raw[severity_train_mask])\n",
        "print('Final label model fitted on all labeled validation rows:', len(val))\n",
        "print('Final severity model fitted on labeled fault rows:', int(severity_train_mask.sum()))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Final inference helper. It returns ONE row per input row — never only the first sample.\n",
        "def predict_dataframe(df):\n",
        "    Xl = d1_features(df)\n",
        "    Xa = -iso.decision_function(Xl)\n",
        "    Xs = severity_features(df, Xa)\n",
        "    labels = label_model.predict(Xl).astype(str)\n",
        "    severities = np.full(len(df), NON_FAULT_SEVERITY, dtype=object)\n",
        "    fault_idx = np.where(np.isin(labels, list(FAULTS)))[0]\n",
        "    if len(fault_idx):\n",
        "        severities[fault_idx] = severity_model.predict(Xs[fault_idx]).astype(str)\n",
        "    out = pd.DataFrame({'label': labels, 'severity': severities, 'anomaly_score': Xa})\n",
        "    if 'engine_id' in df.columns: out.insert(0, 'engine_id', df['engine_id'].to_numpy())\n",
        "    return out\n",
        "print('Prediction helper ready.')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## FINAL TEST INFERENCE — RUN ONLY WHEN READY\n",
        "\n",
        "This is the only cell that reads `test.csv`. Do not use its predictions for further model selection."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "test_path = DATA_DIR/'test.csv'\n",
        "if not test_path.exists():\n",
        "    print('No test.csv found — skipping final inference.')\n",
        "else:\n",
        "    test = pd.read_csv(test_path)\n",
        "    predictions = predict_dataframe(test)\n",
        "    predictions.to_csv('final_predictions.csv', index=False)\n",
        "    print('TEST rows:', len(test))\n",
        "    print('Prediction rows:', len(predictions))\n",
        "    assert len(predictions) == len(test)\n",
        "    print('Label distribution:\n', predictions.label.value_counts())\n",
        "    print('Severity distribution:\n', predictions.severity.value_counts())\n",
        "    display(predictions.head(20))\n",
        "    print('Saved: final_predictions.csv')"
      ]
    }
  ],
